{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/judge/batch",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/segment/batch",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/feedback-report",
      "schedule": "0 9 * * *"
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "next build"
    },
    "eve": {
      "root": ".",
      "framework": "eve",
      "buildCommand": "eve build"
    }
  },
  "rewrites": [
    {
      "source": "/eve/:path*",
      "destination": {
        "service": "eve"
      }
    },
    {
      "source": "/.well-known/workflow/:path*",
      "destination": {
        "service": "eve"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
